{
    "name": "Enterprise AI Platform",
    "settings": "{\"settings\":\"{\\n  //==================================================\\n  // Enterprise AI Platform\\n  // Profile Settings v1.0\\n  // Module 01 - Appearance & User Experience\\n  //==================================================\\n\\n  // ---------- Theme ----------\\n  \\\"workbench.colorTheme\\\": \\\"Dark Modern\\\",\\n  \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n\\n  // ---------- Font ----------\\n  \\\"editor.fontFamily\\\": \\\"'JetBrains Mono', Consolas, 'Courier New', monospace\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"editor.fontSize\\\": 15,\\n  \\\"editor.lineHeight\\\": 26,\\n  \\\"editor.letterSpacing\\\": 0.3,\\n\\n  // ---------- Window ----------\\n  \\\"window.zoomLevel\\\": 0,\\n\\n  // ---------- Cursor ----------\\n  \\\"editor.cursorStyle\\\": \\\"line\\\",\\n  \\\"editor.cursorBlinking\\\": \\\"smooth\\\",\\n  \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n\\n  // ---------- Scrolling ----------\\n  \\\"editor.smoothScrolling\\\": true,\\n  \\\"workbench.list.smoothScrolling\\\": true,\\n\\n  // ---------- Minimap ----------\\n  \\\"editor.minimap.enabled\\\": true,\\n  \\\"editor.minimap.size\\\": \\\"fit\\\",\\n  \\\"editor.minimap.renderCharacters\\\": false,\\n\\n  // ---------- Navigation ----------\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"breadcrumbs.enabled\\\": true,\\n\\n  // ---------- Guides ----------\\n  \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\n  \\\"editor.renderLineHighlight\\\": \\\"all\\\",\\n\\n  // ---------- Explorer ----------\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"explorer.sortOrder\\\": \\\"type\\\",\\n\\n  // ---------- Tabs ----------\\n  \\\"workbench.editor.wrapTabs\\\": true,\\n  \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n\\n  // ---------- Tree ----------\\n  \\\"workbench.tree.indent\\\": 12,\\n  \\\"workbench.tree.renderIndentGuides\\\": \\\"always\\\",\\n\\n  // ---------- Startup ----------\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n\\n  //==================================================\\n  // Module 02 - Editor Experience\\n  //==================================================\\n\\n  // ---------- Suggestions ----------\\n  \\\"editor.quickSuggestions\\\": {\\n    \\\"other\\\": true,\\n    \\\"comments\\\": false,\\n    \\\"strings\\\": true\\n  },\\n\\n  \\\"editor.suggestSelection\\\": \\\"first\\\",\\n  \\\"editor.suggest.preview\\\": true,\\n  \\\"editor.acceptSuggestionOnEnter\\\": \\\"smart\\\",\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.formatOnPaste\\\": true,\\n  \\\"editor.detectIndentation\\\": false,\\n  \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.guides.indentation\\\": true,\\n  \\\"editor.mouseWheelZoom\\\": true,\\n  \\\"workbench.commandPalette.history\\\": 100,\\n  \\\"workbench.tips.enabled\\\": false,\\n  \\\"editor.renderControlCharacters\\\": false,\\n\\n  // ---------- Inline AI ----------\\n  \\\"editor.inlineSuggest.enabled\\\": true,\\n\\n  // ---------- IntelliSense ----------\\n  \\\"editor.tabCompletion\\\": \\\"on\\\",\\n  \\\"editor.parameterHints.enabled\\\": true,\\n  \\\"editor.wordBasedSuggestions\\\": \\\"matchingDocuments\\\",\\n\\n  // ---------- Code Navigation ----------\\n  \\\"editor.gotoLocation.multipleDefinitions\\\": \\\"peek\\\",\\n  \\\"editor.gotoLocation.multipleReferences\\\": \\\"peek\\\",\\n  \\\"editor.gotoLocation.multipleImplementations\\\": \\\"peek\\\",\\n\\n  // ---------- Selection ----------\\n  \\\"editor.selectionHighlight\\\": true,\\n  \\\"editor.occurrencesHighlight\\\": \\\"singleFile\\\",\\n\\n  // ---------- Folding ----------\\n  \\\"editor.folding\\\": true,\\n  \\\"editor.foldingStrategy\\\": \\\"auto\\\",\\n  \\\"editor.showFoldingControls\\\": \\\"mouseover\\\",\\n\\n  // ---------- Brackets ----------\\n  \\\"editor.bracketPairColorization.enabled\\\": true,\\n\\n  // ---------- Code Actions ----------\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.organizeImports\\\": \\\"explicit\\\"\\n  },\\n\\n  // ---------- Rename ----------\\n  \\\"editor.rename.enablePreview\\\": false,\\n\\n  // ---------- Clipboard ----------\\n  \\\"editor.emptySelectionClipboard\\\": false,\\n\\n  //==================================================\\n  // Module 03 - Explorer & Files\\n  //==================================================\\n\\n  // ---------- Explorer ----------\\n  \\\"explorer.confirmDelete\\\": true,\\n  \\\"explorer.confirmDragAndDrop\\\": true,\\n  \\\"explorer.openEditors.visible\\\": 10,\\n\\n  // ---------- File Nesting ----------\\n  \\\"explorer.fileNesting.enabled\\\": true,\\n  \\\"explorer.fileNesting.expand\\\": false,\\n\\n  // ---------- Auto Save ----------\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n  \\\"files.autoSaveDelay\\\": 1000,\\n\\n  // ---------- Encoding ----------\\n  \\\"files.encoding\\\": \\\"utf8\\\",\\n  \\\"files.eol\\\": \\\"\\\\n\\\",\\n\\n  // ---------- Clean Files ----------\\n  \\\"files.trimTrailingWhitespace\\\": true,\\n  \\\"files.insertFinalNewline\\\": true,\\n  \\\"files.trimFinalNewlines\\\": true,\\n\\n  // ---------- Hot Exit ----------\\n  \\\"files.hotExit\\\": \\\"onExitAndWindowClose\\\",\\n\\n  // ---------- Search ----------\\n  \\\"search.useIgnoreFiles\\\": true,\\n  \\\"search.useGlobalIgnoreFiles\\\": true,\\n  \\\"search.followSymlinks\\\": false,\\n\\n  //==================================================\\n  // Module 04 - Terminal & Shell\\n  //==================================================\\n\\n  // ---------- Default Terminal ----------\\n  \\\"terminal.integrated.defaultProfile.windows\\\": \\\"PowerShell\\\",\\n\\n  // ---------- Terminal Location ----------\\n  \\\"terminal.integrated.defaultLocation\\\": \\\"view\\\",\\n\\n  // ---------- Terminal Appearance ----------\\n  \\\"terminal.integrated.fontSize\\\": 15,\\n  \\\"terminal.integrated.cursorStyle\\\": \\\"line\\\",\\n  \\\"terminal.integrated.cursorBlinking\\\": true,\\n  \\\"terminal.integrated.cursorWidth\\\": 1,\\n\\n  // ---------- Terminal Performance ----------\\n  \\\"terminal.integrated.smoothScrolling\\\": true,\\n  \\\"terminal.integrated.scrollback\\\": 10000,\\n\\n  // ---------- Terminal Tabs ----------\\n  \\\"terminal.integrated.tabs.enabled\\\": true,\\n  \\\"terminal.integrated.tabs.showActiveTerminal\\\": \\\"singleTerminal\\\",\\n\\n  // ---------- Session ----------\\n  \\\"terminal.integrated.enablePersistentSessions\\\": true,\\n  \\\"terminal.integrated.persistentSessionReviveProcess\\\": \\\"onExitAndWindowClose\\\",\\n\\n  // ---------- Copy & Paste ----------\\n  \\\"terminal.integrated.copyOnSelection\\\": false,\\n  \\\"terminal.integrated.rightClickBehavior\\\": \\\"paste\\\",\\n\\n  //==================================================\\n  // Module 05 - Git & GitLens\\n  //==================================================\\n\\n// ---------- Git ----------\\n\\\"git.autofetch\\\": true,\\n\\\"git.confirmSync\\\": true,\\n\\\"git.confirmForcePush\\\": true,\\n\\\"git.enableSmartCommit\\\": true,\\n\\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n\\\"git.enableCommitSigning\\\": false,\\n\\\"git.showPushSuccessNotification\\\": true,\\n\\\"git.suggestSmartCommit\\\": true,\\n\\\"git.timeline.showUncommitted\\\": true,\\n\\n  // ---------- Git Decorations ----------\\n  \\\"git.decorations.enabled\\\": true,\\n\\n  // ---------- GitLens ----------\\n  \\\"gitlens.currentLine.enabled\\\": true,\\n  \\\"gitlens.codeLens.enabled\\\": true,\\n  \\\"gitlens.hovers.enabled\\\": true,\\n  \\\"gitlens.statusBar.enabled\\\": true,\\n\\n  // ---------- GitLens Graph ----------\\n  \\\"gitlens.graph.autoFetch.enabled\\\": true,\\n  \\\"gitlens.graph.minimap.enabled\\\": true,\\n\\n  //==================================================\\n  // Module 06 - GitHub Copilot & AI\\n  //==================================================\\n\\n  // ---------- Chat ----------\\n  \\\"chat.commandCenter.enabled\\\": true,\\n\\n  // ---------- Accessibility ----------\\n  \\\"accessibility.verbosity.inlineCompletions\\\": false,\\n\\n  //==================================================\\n  // Module 07 - Performance\\n  //==================================================\\n\\n  // ---------- Editor ----------\\n  \\\"editor.largeFileOptimizations\\\": true,\\n  \\\"editor.occurrencesHighlightDelay\\\": 250,\\n\\n  // ---------- Watcher ----------\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/.git/objects/**\\\": true,\\n    \\\"**/.git/subtree-cache/**\\\": true,\\n    \\\"**/node_modules/**\\\": true,\\n    \\\"**/.next/**\\\": true,\\n    \\\"**/dist/**\\\": true,\\n    \\\"**/.turbo/**\\\": true,\\n    \\\"**/.vercel/**\\\": true\\n  },\\n\\n  // ---------- Search ----------\\n  \\\"search.exclude\\\": {\\n    \\\"**/node_modules\\\": true,\\n    \\\"**/.next\\\": true,\\n    \\\"**/dist\\\": true,\\n    \\\"**/.turbo\\\": true,\\n    \\\"**/.vercel\\\": true,\\n    \\\"**/__pycache__\\\": true,\\n    \\\"**/.pytest_cache\\\": true,\\n    \\\"**/.ruff_cache\\\": true\\n  },\\n\\n  // ---------- Explorer ----------\\n  \\\"files.exclude\\\": {\\n    \\\"**/.DS_Store\\\": true,\\n    \\\"**/Thumbs.db\\\": true,\\n    \\\"**/__pycache__\\\": true,\\n    \\\"**/.pytest_cache\\\": true,\\n    \\\"**/.ruff_cache\\\": true\\n  },\\n\\n  //==================================================\\n  // Module 08 - Debugging\\n  //==================================================\\n\\n  // ---------- Debug ----------\\n  \\\"debug.openDebug\\\": \\\"openOnDebugBreak\\\",\\n  \\\"debug.toolBarLocation\\\": \\\"floating\\\",\\n  \\\"debug.inlineValues\\\": \\\"on\\\",\\n  \\\"debug.allowBreakpointsEverywhere\\\": true,\\n  \\\"debug.confirmOnExit\\\": \\\"always\\\",\\n\\n  // ---------- Problems ----------\\n  \\\"problems.decorations.enabled\\\": true,\\n\\n  //==================================================\\n  // Module 09 - Security & Safety\\n  //==================================================\\n\\n  // ---------- Workspace Trust ----------\\n  \\\"security.workspace.trust.enabled\\\": true,\\n  \\\"security.workspace.trust.startupPrompt\\\": \\\"once\\\",\\n  \\\"security.workspace.trust.untrustedFiles\\\": \\\"prompt\\\",\\n\\n  // ---------- Terminal ----------\\n  \\\"terminal.integrated.confirmOnExit\\\": \\\"always\\\",\\n\\n  // ---------- Editor ----------\\n\\\"files.readonlyFromPermissions\\\": true,\\n\\\"extensions.autoUpdate\\\": true,\\n\\\"extensions.autoCheckUpdates\\\": true,\\n\\n//==================================================\\n// Module 10 - Python Professional\\n//==================================================\\n\\n\\\"[python]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"ms-python.black-formatter\\\",\\n    \\\"editor.formatOnSave\\\": true\\n},\\n\\n\\\"[json]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n},\\n\\n\\\"[jsonc]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n},\\n\\n\\\"python.languageServer\\\": \\\"Pylance\\\",\\n\\\"python.analysis.typeCheckingMode\\\": \\\"basic\\\",\\n\\\"python.analysis.autoImportCompletions\\\": true,\\n\\\"python.analysis.completeFunctionParens\\\": true,\\n\\\"python.analysis.diagnosticMode\\\": \\\"workspace\\\",\\n\\\"python.analysis.inlayHints.functionReturnTypes\\\": true,\\n\\\"python.analysis.inlayHints.callArgumentNames\\\": \\\"all\\\",\\n\\\"python.analysis.enableParallelIndexing\\\": true,\\n\\\"python.analysis.includeAliasesFromUserFiles\\\": true,\\n\\\"python.analysis.logLevel\\\": \\\"Error\\\",\\n\\n\\\"python.terminal.activateEnvironment\\\": true,\\n\\\"python.terminal.useEnvFile\\\": true,\\n\\n\\n//==================================================\\n// Module 10 - Python Quality Tools\\n//==================================================\\n\\\"ruff.enable\\\": true,\\n\\\"ruff.organizeImports\\\": true,\\n\\\"ruff.fixAll\\\": true,\\n\\n//==================================================\\n// Module 11 - AI Agent Environment\\n//==================================================\\n\\\"chat.detectParticipant.enabled\\\": true,\\n\\\"github.copilot.enable\\\": {\\n    \\\"*\\\": true,\\n    \\\"plaintext\\\": false,\\n    \\\"markdown\\\": true,\\n    \\\"scminput\\\": true\\n},\\n\\n}\\n\"}",
